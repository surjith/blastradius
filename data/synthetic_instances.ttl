######################################################################
# Metaobjects + Metafields (demonstrate schema-ish dependencies)
######################################################################

:mo_campaign_summer a ex:Metaobject ;
  ex:gid    "gid://shopify/Metaobject/7001" ;
  ex:name   "Summer Campaign 2026" ;
  ex:status "active" .

:mo_campaign_winter a ex:Metaobject ;
  ex:gid    "gid://shopify/Metaobject/7002" ;
  ex:name   "Winter Campaign 2026" ;
  ex:status "active" .

:mf_prod_hoodie_campaign a ex:Metafield ;
  ex:gid    "gid://shopify/Metafield/8001" ;
  ex:name   "campaign_ref" ;
  ex:status "active" ;
  ex:metafieldOwner :prod_hoodie ;
  ex:referencesMetaobject :mo_campaign_summer .

:mf_prod_mug_campaign a ex:Metafield ;
  ex:gid    "gid://shopify/Metafield/8002" ;
  ex:name   "campaign_ref" ;
  ex:status "active" ;
  ex:metafieldOwner :prod_mug ;
  ex:referencesMetaobject :mo_campaign_summer .

:mf_prod_tote_campaign a ex:Metafield ;
  ex:gid    "gid://shopify/Metafield/8003" ;
  ex:name   "campaign_ref" ;
  ex:status "active" ;
  ex:metafieldOwner :prod_tote ;
  ex:referencesMetaobject :mo_campaign_winter .

:mf_prod_cap_campaign a ex:Metafield ;
  ex:gid    "gid://shopify/Metafield/8004" ;
  ex:name   "campaign_ref" ;
  ex:status "active" ;
  ex:metafieldOwner :prod_cap ;
  ex:referencesMetaobject :mo_campaign_winter .

# Link owners to their metafields via hasMetafield
:prod_hoodie  ex:hasMetafield :mf_prod_hoodie_campaign .
:prod_mug     ex:hasMetafield :mf_prod_mug_campaign .
:prod_tote    ex:hasMetafield :mf_prod_tote_campaign .
:prod_cap     ex:hasMetafield :mf_prod_cap_campaign .
