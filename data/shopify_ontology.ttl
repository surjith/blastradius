@prefix : <http://www.semanticweb.org/owl/owlapi/turtle#> .
@prefix ex: <https://example.com/shopify-onto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://example.com/shopify-onto#ShopifyOntology> .

<https://example.com/shopify-onto#ShopifyOntology> rdf:type owl:Ontology ;
                                                   
                                                   rdfs:label "Shopify Admin (POC) Ontology" ;
                                                   
                                                   owl:imports <https://example.com/shopify-onto#ShopifyOntology> .


#################################################################
#
#    Object Properties
#
#################################################################


###  https://example.com/shopify-onto#fulfilledFrom

ex:fulfilledFrom rdf:type owl:ObjectProperty ;
                 
                 rdfs:domain ex:Fulfillment ;
                 
                 rdfs:range ex:Location .



###  https://example.com/shopify-onto#fulfillsLineItem

ex:fulfillsLineItem rdf:type owl:ObjectProperty ;
                    
                    rdfs:domain ex:Fulfillment ;
                    
                    rdfs:range ex:LineItem .



###  https://example.com/shopify-onto#hasFulfillment

ex:hasFulfillment rdf:type owl:ObjectProperty ;
                  
                  rdfs:range ex:Fulfillment ;
                  
                  rdfs:domain ex:Order .



###  https://example.com/shopify-onto#hasInventoryItem

ex:hasInventoryItem rdf:type owl:ObjectProperty ;
                    
                    rdfs:range ex:InventoryItem ;
                    
                    rdfs:domain ex:ProductVariant .



###  https://example.com/shopify-onto#hasLineItem

ex:hasLineItem rdf:type owl:ObjectProperty ;
               
               rdfs:range ex:LineItem ;
               
               rdfs:domain ex:Order .



###  https://example.com/shopify-onto#hasMetafield

ex:hasMetafield rdf:type owl:ObjectProperty ;
                
                rdfs:domain owl:Thing ;
                
                rdfs:range ex:Metafield .



###  https://example.com/shopify-onto#hasVariant

ex:hasVariant rdf:type owl:ObjectProperty ;
              
              rdfs:domain ex:Product ;
              
              rdfs:range ex:ProductVariant .



###  https://example.com/shopify-onto#metafieldOwner

ex:metafieldOwner rdf:type owl:ObjectProperty ;
                  
                  rdfs:range owl:Thing ;
                  
                  rdfs:domain ex:Metafield .



###  https://example.com/shopify-onto#orderedBy

ex:orderedBy rdf:type owl:ObjectProperty ;
             
             rdfs:range ex:Customer ;
             
             rdfs:domain ex:Order .



###  https://example.com/shopify-onto#references

ex:references rdf:type owl:ObjectProperty ;
              
              rdfs:domain ex:LineItem ;
              
              rdfs:range ex:ProductVariant .



###  https://example.com/shopify-onto#referencesMetaobject

ex:referencesMetaobject rdf:type owl:ObjectProperty ;
                        
                        rdfs:domain ex:Metafield ;
                        
                        rdfs:range ex:Metaobject .





