#
#    Data properties
#
#################################################################


###  https://example.com/shopify-onto#gid

ex:gid rdf:type owl:DatatypeProperty ;
       
       rdfs:range xsd:string ;
       
       rdfs:domain owl:Thing .



###  https://example.com/shopify-onto#name

ex:name rdf:type owl:DatatypeProperty ;
        
        rdfs:range xsd:string ;
        
        rdfs:domain owl:Thing .



###  https://example.com/shopify-onto#sku

ex:sku rdf:type owl:DatatypeProperty ;
       
       rdfs:range xsd:string ;
       
       rdfs:domain ex:InventoryItem .



###  https://example.com/shopify-onto#status

ex:status rdf:type owl:DatatypeProperty ;
          
          rdfs:range xsd:string ;
          
          rdfs:domain owl:Thing .





